# =============================================================================
# ReNovu - Environment Configuration
# =============================================================================
# Copy to .env and customize for your environment.
#
# IMPORTANT: Security keys and MongoDB credentials must match existing data.
# Changing them will break encrypted content, JWT tokens, etc.
# =============================================================================

# Node Environment
NODE_ENV=local

# -----------------------------------------------------------------------------
# MongoDB (must match existing data)
# -----------------------------------------------------------------------------
MONGO_USER=novu
MONGO_PASSWORD=novu-dev-password

# -----------------------------------------------------------------------------
# Redis (own instance, independent from ArokaGO)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=arokago-redis-dev

# -----------------------------------------------------------------------------
# Security Keys (must match existing data — do NOT change)
# -----------------------------------------------------------------------------
JWT_SECRET=novu-jwt-secret-change-in-production
STORE_ENCRYPTION_KEY=novu-32char-encryption-key!!!!!!
NOVU_SECRET_KEY=novu-secret-key-change-in-prod!

# -----------------------------------------------------------------------------
# External URLs (browser-accessible)
# -----------------------------------------------------------------------------
# Local development
API_EXTERNAL_URL=http://localhost:3001
WS_EXTERNAL_URL=http://localhost:3002
DASHBOARD_EXTERNAL_URL=http://localhost:4000

# Production (set in Coolify)
# API_EXTERNAL_URL=https://novu-api.arokago.com
# WS_EXTERNAL_URL=https://novu-ws.arokago.com
# DASHBOARD_EXTERNAL_URL=https://novu.arokago.com

# Ports (local development only, not used by production compose)
DASHBOARD_PORT=4000
API_PORT=3001
WS_PORT=3002

# -----------------------------------------------------------------------------
# GHCR Image Tag (for docker-compose.production.yml)
# -----------------------------------------------------------------------------
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Docker Platform (override for Mac ARM; Coolify uses default linux/amd64)
# -----------------------------------------------------------------------------
# DOCKER_PLATFORM=linux/arm64

# -----------------------------------------------------------------------------
# PM2 Cluster Instances (local: 2 to save memory; production/Coolify: max)
# -----------------------------------------------------------------------------
# PM2_INSTANCES=2

# -----------------------------------------------------------------------------
# Data Directory (for production bind mounts)
# -----------------------------------------------------------------------------
# RENOVU_DATA_DIR=./data/renovu

# -----------------------------------------------------------------------------
# Resource Limits (optional, production only)
# -----------------------------------------------------------------------------
# REDIS_MEMORY_LIMIT=512M
# REDIS_MEMORY_RESERVATION=256M
# MONGO_MEMORY_LIMIT=2G
# MONGO_MEMORY_RESERVATION=1G
# API_MEMORY_LIMIT=1G
# API_MEMORY_RESERVATION=512M
# WORKER_MEMORY_LIMIT=1G
# WORKER_MEMORY_RESERVATION=512M
# WS_MEMORY_LIMIT=512M
# WS_MEMORY_RESERVATION=256M
# DASHBOARD_MEMORY_LIMIT=512M
# DASHBOARD_MEMORY_RESERVATION=256M

# -----------------------------------------------------------------------------
# S3/Storage (optional)
# -----------------------------------------------------------------------------
S3_REGION=us-east-1
S3_BUCKET_NAME=renovu-local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Admin Tools (backup / restore / export / import)
# -----------------------------------------------------------------------------
# When ADMIN_API_KEY is set, requests carrying `X-Admin-API-Key: <value>` bypass
# JWT auth on admin-tools. Required for the CLI scripts and CI usage.
# ADMIN_API_KEY=

# Restrict backup/restore endpoints to instance admins (API-key auth only).
# Set to "true" once you onboard a teammate to a single project — the current
# backup format is whole-instance and a per-project user could otherwise
# exfiltrate every other project's data. Default ("false") preserves the
# v1.x dashboard "Create Backup" button for solo-admin deployments.
# BACKUP_REQUIRES_INSTANCE_ADMIN=false

# Skip the on-startup migration runner. Set to "true" only in unit-test
# environments. Production must leave this unset so the API runs pending
# migrations from apps/api/src/migrations-runtime/registry.ts automatically.
# SKIP_MIGRATIONS_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
